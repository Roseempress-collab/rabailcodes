void Game::play()
{
    generateMaze();

    while (player.getLives() > 0)
    {
        system("cls");

        displayHUD();

        maze->display();

        player.displayInfo();

        for (int i = 0; i < numEnemies; i++)
        {
            if (!enemies[i].destroyed &&
                !enemyDestroyedThisLevel[i])
            {
                enemies[i].displayInfo();
            }
        }

        cout << "\nMove (W/A/S/D)";
        cout << "\nPress SPACE to attack adjacent enemy: ";

        char ch = _getch();

        //if (ch == ' ')
        //{
        //    tryDestroyEnemy();
        //}
        ///else
         if (ch == 'w' ||
                 ch == 'a' ||
                 ch == 's' ||
                 ch == 'd')
        {
            movePlayer(ch);
        }

        moveEnemies();

        checkPlayerEnemyCollision();
    }

    cout << "\nGAME OVER!\n";
    cout << "Final Score: "
         << player.getScore() << endl;
}

